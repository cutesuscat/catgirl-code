# Inputs for `node scripts/self-host.ts deploy`. Copy to .env.selfhost (git ignores it) and fill in.
# SELF-HOSTING.md explains each one and what it costs.

# Required: the Cloudflare account the instance lives in, and an API token for it.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Required: your Clerk application (Clerk dashboard > API keys), and the JWT template the apps
# ask for (Clerk dashboard > JWT templates; its `aud` claim must equal CLERK_JWT_AUDIENCE).
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_TEMPLATE=t3-relay
CLERK_JWT_AUDIENCE=t3-code-relay
# Optional: lets `t3 connect` sign in from a terminal (Clerk OAuth application client ID).
# CLERK_CLI_OAUTH_CLIENT_ID=

# Required unless you deploy with --trial: any Postgres the internet can reach, such as Neon.
# RELAY_DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Optional: a domain on this Cloudflare account. Without one the instance lives at
# https://<RELAY_WORKER_NAME>.<your subdomain>.workers.dev and cannot give machines endpoints.
# RELAY_API_ZONE_NAME=example.com
# RELAY_TUNNEL_ZONE_NAME=example.com

# Optional: names. A stage keeps two instances in one account apart.
# RELAY_STAGE=prod
# RELAY_WORKER_NAME=catgirl-connect

# What the signed service document tells people about your instance.
CONNECT_SERVICE_NAME=My cats
# CONNECT_OPERATOR_CONTACT=https://example.com/contact
# CONNECT_PRIVACY_POLICY_URL=https://example.com/privacy
# CONNECT_HOSTED_APP_URL=https://app.example.com
# Which collectors the document offers: analytics, crashReports, traces (comma separated), or none.
# CONNECT_DIAGNOSTICS=analytics,crashReports,traces
# Raise by one to rotate the signing key; the old key endorses the new one.
# CONNECT_SIGNING_KEY_GENERATION=1
# Only for an instance deployed before cat-first keys (before Catgirl Code 0.1.12b): set it to the
# generation you rotate to, so the plain keys apps pinned before are still found. See SELF-HOSTING.md.
# CONNECT_SIGNING_KEY_CAT_FIRST_SINCE=1

# Optional: phone notifications. iPhone needs an Apple Developer account; Android a Firebase project.
# APNS_ENABLED=false
# FCM_SERVICE_ACCOUNT={...}

# Optional: the relay's own request tracing in Axiom.
# RELAY_AXIOM=on
# AXIOM_TOKEN=
# AXIOM_ORG_ID=

# Optional: t3gate mode, machines reached through your own TLS gateway instead of Cloudflare tunnels.
# T3GATE_SECRET=
# T3GATE_GATE=gate.example.com
# T3GATE_PROXY_IP=203.0.113.10
# T3GATE_PINS=
# T3GATE_TRUSTED=
# T3GATE_MAX_TUNNELS=20
